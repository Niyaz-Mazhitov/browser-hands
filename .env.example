# Скопировать в .env (chmod 600). Ключ обязателен, остальное — значения по умолчанию: раскомментировать, чтобы переопределить.
OPENROUTER_API_KEY=

# Браузер
# BROWSER_HANDS_MODE=attach
# BROWSER_HANDS_WS_URL=
# BROWSER_HANDS_CHROME_DATA_DIR="~/Library/Application Support/Google/Chrome"
# BROWSER_HANDS_LAUNCH_DATA_DIR=~/.cache/browser-hands/chrome-profile
# BROWSER_HANDS_CHROME_BINARY="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
# BROWSER_HANDS_HEADLESS=0
# BROWSER_HANDS_CONNECT_TIMEOUT_S=60
# BROWSER_HANDS_SCREENSHOT_QUALITY=60
# BROWSER_HANDS_SCREENSHOT_SCALE=1

# Модели. OPENROUTER_API_KEY подставляется, только если адрес модели на openrouter.ai; для другого адреса — свой ключ
# BROWSER_HANDS_JEV_URL=https://openrouter.ai/api/v1/systemone
# BROWSER_HANDS_JEV_MODEL=jev-latest
# BROWSER_HANDS_JEV_API_KEY=
# BROWSER_HANDS_TEXT_BASE_URL=https://openrouter.ai/api/v1
# BROWSER_HANDS_TEXT_MODEL=inception/mercury-2.5
# BROWSER_HANDS_TEXT_API_KEY=
# BROWSER_HANDS_TEXT_REASONING=none

# Прогон (потолки: шагов 1–50, дедлайн до 300 с)
# BROWSER_HANDS_MAX_STEPS=25
# BROWSER_HANDS_TIMEOUT_S=90

# Логи (stderr); полный url и цель — только на DEBUG
# BROWSER_HANDS_LOG=INFO
